{
  "manifest_version": 3,
  "name": "おさむくん - 定型文検索・コピー",
  "version": "1.1.0",
  "minimum_chrome_version": "114",
  "description": "定型文（テンプレート・スニペット）を登録・検索して、ワンクリックでコピー。メールの定型文管理に。完全オフライン動作。",
  "permissions": ["sidePanel", "storage"],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "おさむくんを開く",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "_execute_action": {
      "description": "おさむくんのサイドパネルを開く"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
